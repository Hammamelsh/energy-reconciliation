.venv/
__pycache__/
.pytest_cache/
.ruff_cache/
.env
data/raw/
data/processed/
data/sample/
data/warehouse/
# Baselines name real household ids and load identities: kept local.
data/baselines/
# Comparison reports name real household ids: kept local.
data/comparisons/
# Forecast experiment reports name real household ids: kept local.
data/forecasts/
# ANL-004 zero-day reports name real household ids: kept local.
data/quality/
# The demo fixture itself is tracked; profiler output over it is not.
data/demo/*-profile.json
*.duckdb

# Local learning-context files: kept on disk, not published.
# Root-anchored so only these top-level files are ignored.
/AGENTS.md
/CLAUDE.md
/PROJECT_CONTEXT.md

# Local Claude Code settings (attribution preference): local only, never published.
/.claude/settings.local.json

# dbt build artefacts (ANL-003). The project files and the generated macro ARE tracked;
# compiled SQL, logs and installed packages are not.
dbt/target/
dbt/logs/
dbt/dbt_packages/
# A random per-machine identifier written by dbt. Never committed.
dbt/.user.yml

# Disposable fixtures for the publication proof (tests/test_publication_proof.py). Kept
# under the repository so they sit on the real ext4 filesystem rather than tmpfs.
data/proof-scratch/
